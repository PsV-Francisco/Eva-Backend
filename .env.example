# Copia este archivo como .env y genera un valor seguro para DJANGO_SECRET_KEY.
DJANGO_SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Para desarrollo local usa SQLite. En EC2 configura mysql y los valores DB_*.
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Configuración SMTP (necesaria para enviar correos en producción).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SGR <no-reply@localhost>
PASSWORD_RESET_DOMAIN=localhost:8000
PASSWORD_RESET_PROTOCOL=http
PASSWORD_RESET_TIMEOUT=3600
